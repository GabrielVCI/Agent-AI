# ---------------------------------------------------------------------------
# Envío de formularios (Web3Forms) — /contacto y el modal de lista de espera
# en /precios. No hay backend propio: el navegador envía directo a la API de
# Web3Forms (ver src/lib/web3forms.ts).
#
# La Access Key de Web3Forms es pública por diseño (identifica el formulario,
# no autoriza acciones privilegiadas), por eso puede vivir en una variable
# VITE_ y quedar expuesta en el frontend.
# ---------------------------------------------------------------------------

VITE_WEB3FORMS_ACCESS_KEY=replace_with_web3forms_access_key
VITE_WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit

# ---------------------------------------------------------------------------
# Google reCAPTCHA v3 — capa adicional anti-bots.
# La Site Key también es pública y puede exponerse en el frontend.
# ---------------------------------------------------------------------------

VITE_RECAPTCHA_SITE_KEY=replace_with_recaptcha_site_key

# ---------------------------------------------------------------------------
# IMPORTANTE: la reCAPTCHA Secret Key NUNCA va aquí ni en ninguna variable
# VITE_ (eso la expondría en el frontend). Se configura directamente en el
# dashboard de Web3Forms (Settings → Captcha), que la usa server-side para
# verificar el token antes de reenviar el formulario. Ver README, sección
# "Configurar reCAPTCHA en Web3Forms".
# ---------------------------------------------------------------------------
