# ---------------------------------------------------------------------------
# Envío del formulario de contacto (Netlify Function + Resend)
# Estas variables son SECRETAS y se usan solo en el servidor (Netlify Function).
# NO usar el prefijo VITE_ para secretos: eso las expondría en el frontend.
# En producción se configuran en: Netlify → Site settings → Environment variables.
# ---------------------------------------------------------------------------

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=replace_with_resend_api_key

# Remitente verificado en Resend (dominio verificado)
CONTACT_FROM_EMAIL=contacto@tudominio.com

# Bandeja del negocio que recibe las solicitudes
CONTACT_TO_EMAIL=ventas@tudominio.com

# Opcional: correo para respuestas (si se omite, se usa el email del visitante)
CONTACT_REPLY_TO_EMAIL=

# Nombre de la plataforma (aparece en los correos)
CONTACT_SITE_NAME=Sendwary

# ---------------------------------------------------------------------------
# Frontend (público). Solo la URL del endpoint de envío.
# Por defecto apunta a la Netlify Function incluida en este repo.
# Cambiar solo si el endpoint vive en otro dominio/servicio.
# ---------------------------------------------------------------------------
VITE_CONTACT_ENDPOINT=/.netlify/functions/contact
