# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# OJO: TODO lo que empieza con VITE_ termina en el bundle público del
# navegador. NUNCA poner aquí secretos (app secret, tokens, API keys).

# URL del backend. Vacío = mismo origen / proxy de desarrollo.
VITE_API_URL=

# ─── Meta WhatsApp Embedded Signup ───────────────────────────────────────────
# Estos valores son PÚBLICOS por diseño: el SDK de Facebook los necesita en el
# navegador. La configuración real la sirve el backend en
# /api/integrations/whatsapp (capabilities.embeddedSignup); estas variables
# solo actúan como respaldo si el backend no la envía.
VITE_META_APP_ID=1380874503874335
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v21.0
VITE_META_EMBEDDED_SIGNUP_ENABLED=false

# NUNCA definir aquí: META_APP_SECRET, META_SYSTEM_USER_ACCESS_TOKEN,
# RESEND_APIKEY ni ningún token de acceso. Solo backend.
