# ============================================================================
# Entorno de PRUEBAS — plantilla
#
#   cp .env.test.example .env.test   y ajusta la contraseña de PostgreSQL.
#
# Reglas de este archivo:
#   · El nombre de la base de DATABASE_URL DEBE terminar en "_test".
#     tests/setup/use-test-db.ts aborta la corrida si no es así.
#   · Ninguna credencial real. Todos los valores externos son falsos y
#     deterministas: si una prueba llega de verdad a un servicio externo, es
#     un bug de la prueba, no algo que deba "funcionar".
#   · Este archivo NO reemplaza a .env: solo se carga al ejecutar las pruebas.
# ============================================================================

# ── Base de datos ───────────────────────────────────────────────────────────
# Se crea y migra con: npm run test:db:setup
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/ferreteria_ai_agent_test?schema=public"
# Base desechable que Prisma vacía en cada uso. Nunca apuntarla a datos reales.
SHADOW_DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/ferreteria_ai_agent_shadow"

# ── Entorno ─────────────────────────────────────────────────────────────────
NODE_ENV=test
APP_ENV=development
PORT=3999
# El worker procesa jobs reales: apagado siempre en pruebas.
AUTOMATION_WORKER_ENABLED=false
# Sin límites de tasa: falsearían resultados al correr muchas pruebas seguidas.
RATE_LIMIT_ENABLED=false
LOG_LEVEL=error

# ── Sesión y cifrado (valores falsos, formato válido) ───────────────────────
SESSION_SECRET="test-session-secret-no-usar-fuera-de-pruebas-0123456789"
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=3600
COOKIE_SAMESITE=lax
# 64 caracteres hex — requisito de formato de ENCRYPTION_KEY.
ENCRYPTION_KEY="00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"

# ── Redis ───────────────────────────────────────────────────────────────────
# Las sesiones viven en PostgreSQL; Redis es solo caché. Si no está levantado,
# las pruebas siguen funcionando.
REDIS_URL="redis://localhost:6379"

# ── Servicios externos: TODO FALSO ──────────────────────────────────────────
OPENAI_API_KEY="sk-test-fake-no-real-key"
META_WHATSAPP_TOKEN="test-fake-meta-token"
META_VERIFY_TOKEN="test-verify-token"
META_PHONE_NUMBER_ID="000000000000000"
META_APP_ID="000000000000000"
META_APP_SECRET="test-fake-app-secret"
ALLOW_GLOBAL_META_TOKEN_FALLBACK=false
RESEND_APIKEY="re_test_fake_key"
EMAIL_PROVIDER=log
EMAIL_FROM="pruebas@example.test"
LEMONSQUEEZY_API_KEY="test-fake-ls-key"
LEMONSQUEEZY_WEBHOOK_SECRET="test-fake-ls-webhook-secret"
LEMONSQUEEZY_STORE_ID="99001"
ELEVENLABS_API_KEY="test-fake-11labs-key"

# ── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
BACKEND_PUBLIC_URL="http://localhost:3999"
CORS_ORIGIN="http://localhost:5173"
STORAGE_PATH="../storage"
DEFAULT_PHONE_COUNTRY=DO
