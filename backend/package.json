{
  "name": "ferreteria-ai-agent-backend",
  "version": "1.0.0",
  "description": "Backend MVP para agente IA de ventas por WhatsApp para ferreterías",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:db && npm run test:http",
    "test:http": "npm run test:http:auth && npm run test:http:register && npm run test:http:roles && npm run test:http:superadmin && npm run test:http:gates && npm run test:http:isolation && npm run test:http:agents && npm run test:http:conversations && npm run test:http:checkout && npm run test:http:lswebhook",
    "test:http:agents": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/agents.http.test.ts",
    "test:http:conversations": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/conversations.http.test.ts",
    "test:http:auth": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/auth.http.test.ts",
    "test:http:register": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/register.http.test.ts",
    "test:http:roles": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/roles.http.test.ts",
    "test:http:superadmin": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/superadmin.http.test.ts",
    "test:http:gates": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/activation-gates.http.test.ts",
    "test:http:isolation": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/tenant-isolation.http.test.ts",
    "test:unit": "node --import tsx --test tests/automation-unit.test.ts tests/customer-unit.test.ts tests/customer-categories-unit.test.ts tests/service-history-unit.test.ts tests/frontend-auth-storage.test.ts tests/lemonsqueezy-unit.test.ts tests/lemonsqueezy-first-payment-unit.test.ts",
    "test:db:setup": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx scripts/setup-test-db.ts",
    "test:db": "npm run test:db:automation && npm run test:db:customers && npm run test:db:categories && npm run test:db:history && npm run test:db:maintenance && npm run test:db:integrity",
    "test:db:automation": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/automation-engine.test.ts",
    "test:db:customers": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/customer-master.test.ts",
    "test:db:categories": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/customer-categories.test.ts",
    "test:db:history": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/service-history.test.ts",
    "test:db:maintenance": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/maintenance.test.ts",
    "qa:preflight": "node ../scripts/qa-preflight.mjs",
    "qa:preflight:quick": "node ../scripts/qa-preflight.mjs --quick",
    "qa:env": "node ../scripts/qa-preflight.mjs --quick --skip-lint --skip-types --skip-db",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "seed:plans": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx scripts/seed-plans.ts",
    "backfill:customers": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx scripts/backfill-customers.ts",
    "backfill:customer-categories": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx scripts/backfill-customer-categories.ts",
    "backfill:service-history": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx scripts/backfill-service-history.ts",
    "smoke:customers": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library tsx scripts/smoke-customers.ts",
    "test:http:checkout": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/billing-checkout.http.test.ts",
    "test:http:lswebhook": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/http/lemonsqueezy-webhook.http.test.ts",
    "test:db:integrity": "cross-env PRISMA_CLIENT_ENGINE_TYPE=library node --import tsx --import ./tests/setup/use-test-db.ts --test tests/db-integrity.test.ts"
  },
  "keywords": [
    "whatsapp",
    "ai-agent",
    "ferreteria",
    "quotes",
    "n8n"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/form-data": "^2.2.1",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "libphonenumber-js": "^1.13.11",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "ngrok": "^5.0.0-beta.2",
    "nodemailer": "^9.0.3",
    "openai": "^6.38.0",
    "pg": "^8.21.0",
    "puppeteer": "^25.0.4",
    "resend": "^6.18.0",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
