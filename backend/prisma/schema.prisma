generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AliasType {
  SYNONYM
  TECHNICAL_NAME
  COMMON_MISTAKE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Estado COMERCIAL del tenant (registro → verificación → implementación →
// activación final). Independiente de TenantStatus (operativo): un tenant
// legado queda ACTIVE y conserva el comportamiento actual del paywall.
enum TenantLifecycleStatus {
  REGISTERED
  EMAIL_PENDING
  EMAIL_VERIFIED
  IMPLEMENTATION_PENDING
  IMPLEMENTATION_IN_PROGRESS
  IMPLEMENTATION_COMPLETED
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  AGENT_OPERATOR
  BILLING
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ConversationChannel {
  WHATSAPP
  VOICE
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  STARTED
  COMPLETED
  FAILED
  CANCELLED
}

// Cómo se cobra la suscripción: venta manual (transferencia/acuerdo),
// LemonSqueezy (checkout online), gratis, o acuerdo custom.
enum BillingMode {
  MANUAL
  LEMONSQUEEZY
  FREE
  CUSTOM
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  OVERDUE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCEL_REQUESTED
  CANCELLED
  TRIALING
  EXPIRED
}

// Webhook de billing que NO se pudo asociar a ningún tenant (sin custom_data
// y sin match por email de owner). Queda para revisión manual del SUPER_ADMIN:
// NUNCA se activa un tenant "adivinando".
model UnmatchedBillingWebhook {
  id                         String    @id @default(cuid())
  provider                   String    @default("LEMONSQUEEZY")
  eventName                  String
  lemonSqueezySubscriptionId String?
  customerEmail              String?
  payloadJson                Json
  createdAt                  DateTime  @default(now())
  resolvedAt                 DateTime?

  @@index([createdAt])
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  NO_SHOW
  COMPLETED
}

enum AppointmentConfirmation {
  UNCONFIRMED
  CONFIRMED
  DECLINED
}

enum AppointmentPriority {
  LOW
  NORMAL
  HIGH
  FOLLOW_UP
}

enum AppointmentSource {
  AI
  MANUAL
  WHATSAPP
  ADMIN
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum AgentType {
  SALES
  SUPPORT
  APPOINTMENTS
  CUSTOM
}

enum AgentStatus {
  ACTIVE
  DISABLED
}

enum ConversationStatus {
  OPEN
  BOT_ACTIVE
  HUMAN_ACTIVE
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  CUSTOMER
  AGENT
  HUMAN
  SYSTEM
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  TEMPLATE
}

enum QuoteStatus {
  DRAFT
  SENT
  NEEDS_CONFIRMATION
  CANCELLED
}

enum HandoffStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CANCELLED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum IntegrationType {
  WHATSAPP
  OPENAI
  PAYMENT
  STORAGE
  CUSTOM
  // Herramientas externas de agenda (Excel local hoy; Graph/Sheets en el futuro)
  EXCEL
  GOOGLE_SHEETS
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

// Proveedor técnico que transporta los mensajes. META_CLOUD es el único
// implementado hoy; los BSP quedan declarados para que la abstracción de
// providers (services/whatsapp-providers/) pueda enrutarlos sin migración.
enum WhatsAppProvider {
  META_CLOUD
  TWILIO
  DIALOG360
  INFOBIP
  EIGHTX8
  SENDWARY_DEMO
  OTHER
}

// CÓMO conectó el tenant su WhatsApp (independiente del proveedor):
// - EASY_ONBOARDING: conexión guiada (Embedded Signup/BSP o asistida por el
//   equipo Sendwary mientras esa vía no esté aprobada).
// - MANUAL_CLOUD_API: el cliente ya tiene su app de Meta y pega credenciales.
// - DEMO_SANDBOX: número controlado por Sendwary, solo para pruebas.
enum WhatsAppConnectionMode {
  EASY_ONBOARDING
  MANUAL_CLOUD_API
  DEMO_SANDBOX
}

// Situación REAL del número del cliente frente a WhatsApp Business Platform.
// Es distinto del estado de la integración: un número puede estar declarado y
// evaluado (PERSONAL_WHATSAPP) mucho antes de existir una conexión técnica.
enum WhatsAppNumberReadiness {
  UNKNOWN
  PERSONAL_WHATSAPP // hoy en WhatsApp normal: no se conecta "solo escribiéndolo"
  WHATSAPP_BUSINESS_APP // en la app WhatsApp Business: candidato, requiere flujo oficial
  CLOUD_API_READY // ya tiene Cloud API propio: puede ir a configuración avanzada
  BSP_CONNECTED // está con un proveedor externo: evaluar migración
  NEW_NUMBER_RECOMMENDED // lo más seguro y rápido: número dedicado nuevo
  NEEDS_MIGRATION // hay que migrarlo desde donde está
  NEEDS_ASSISTED_SETUP // el equipo Sendwary debe intervenir
  CONNECTED // conectado y validado contra la API oficial
  ERROR
}

// Seguimiento operativo de la preparación del número (lo mueve el equipo).
enum WhatsAppReadinessStage {
  PENDING // el cliente declaró su número, nadie lo ha revisado
  IN_REVIEW // el equipo lo está evaluando
  READY_TO_CONNECT // listo para Embedded Signup / conexión
  CONNECTED
  REQUIRES_CUSTOMER_ACTION // esperando algo del cliente
}

enum WhatsAppIntegrationStatus {
  DRAFT // guardada pero aún no validada contra Meta
  CONNECTING // conexión en curso (asistida por Sendwary o Embedded Signup)
  CONNECTED // validada: token y phoneNumberId funcionan
  REQUIRES_ACTION // falta algo del cliente (número, verificación, datos)
  ERROR // última validación falló (ver lastValidationError)
  DISABLED // apagada por el tenant o por un admin
}

enum MetricType {
  CONVERSATION
  MESSAGE
  QUOTE
  AUDIO_TRANSCRIPTION
  HUMAN_HANDOFF
  HUMAN_REPLY
  AI_REPLY
  UNANSWERED_CONVERSATION
  CLOSED_CONVERSATION
  REOPENED_CONVERSATION
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  legalName String?
  rnc       String?
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  industry  String?
  timezone  String       @default("America/Santo_Domingo")
  status    TenantStatus @default(ACTIVE)
  // Contexto de entrenamiento del negocio (servicios, horarios, políticas,
  // FAQs, mensajes...). Estructurado en JSON; ver types/training.types.ts.
  trainingConfig Json?
  // Respuestas del onboarding post-registro (mensajes/mes, objetivo, etc.).
  onboarding            Json?
  onboardingCompletedAt DateTime?
  // Config de citas/recordatorios: { reminderEnabled, reminderHoursBefore,
  // reminderMessageTemplate, autoConfirmAI }
  appointmentSettings Json?
  // Notas comerciales internas del SUPER_ADMIN (el tenant nunca las ve)
  internalNotes    String?
  createdByAdminId String?
  // Config de llamadas IA: { enabled, minutesPerUser, monthlyMinutesLimit,
  // allowedAgentIds, businessPhoneNumbers } — ver voice.service.ts
  voiceSettings Json?

  // ── Flujo comercial (verificación → implementación → activación final) ──
  // Default ACTIVE: los tenants existentes no cambian de comportamiento; los
  // self-service nuevos se crean con el estado que corresponda en onboarding.
  lifecycleStatus TenantLifecycleStatus @default(ACTIVE)
  // Cuando el OWNER verificó su correo (espejo informativo de User.emailVerifiedAt)
  emailVerifiedAt DateTime?
  // Pago de implementación registrado por SUPER_ADMIN
  implementationFeePaidAt DateTime?
  implementationStartedAt DateTime?
  implementationExpectedEndAt DateTime?
  // Activación final fijada por SUPER_ADMIN: desde aquí corre el primer mes
  finalActivationDate DateTime?
  // Siempre = finalActivationDate + 1 mes (recalculado al cambiar la fecha)
  firstMonthEndsAt DateTime?
  // Bypass temporal del paywall autorizado por SUPER_ADMIN
  paywallBypassUntil  DateTime?
  paywallBypassReason String?
  // Notas técnicas del equipo de implementación (nunca visibles para el cliente)
  internalImplementationNotes String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                User[]
  agents               Agent[]
  conversations        Conversation[]
  quotes               Quote[]
  customers            Customer[]
  products             Product[]
  subscription         Subscription?
  cancellationRequests CancellationRequest[]
  integrations         Integration[]
  whatsappIntegrations WhatsAppIntegration[]
  knowledgeDocuments   KnowledgeDocument[]
  usageMetrics         UsageMetric[]
  idempotencyKeys      IdempotencyKey[]
  categories           Category[]
  appointments         Appointment[]
  usageCounters        UsageCounter[]
  voiceUsageCounters   VoiceUsageCounter[]
  callLogs             CallLog[]

  @@index([status])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  name         String
  lastName     String?
  email        String     @unique
  // Opcional: usuarios creados vía Google OAuth no tienen contraseña local.
  passwordHash String?
  googleId     String?    @unique
  authProvider AuthProvider @default(LOCAL)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  // Verificación de correo: null = pendiente. Usuarios creados por SUPER_ADMIN
  // o vía Google (email_verified) nacen verificados; los existentes se
  // backfillean para no bloquear a nadie.
  emailVerifiedAt         DateTime?
  emailVerificationSentAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant                Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions              Session[]
  assignedConversations Conversation[]       @relation("AssignedConversations")
  cancellationRequests  CancellationRequest[]
  callLogs              CallLog[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([tenantId])
  @@index([email])
}

// Tokens de recuperación de contraseña: solo se guarda el hash (sha256),
// expiran y son de un solo uso (usedAt). El token plano viaja únicamente
// en el link que recibe el usuario.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Tokens de verificación de correo (mismo patrón que PasswordResetToken):
// solo se guarda el hash sha256, expiran (48h) y son de un solo uso (usedAt).
// El token plano viaja únicamente en el link del correo de bienvenida.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Plan {
  id                      String   @id @default(cuid())
  // Código comercial estable (BASIC/PRO/ENTERPRISE); null en planes legados.
  code                    String?  @unique
  name                    String
  description             String?
  maxAgents               Int
  maxUsers                Int?
  maxWhatsappNumbers      Int
  maxMonthlyConversations Int
  maxMonthlyQuotes        Int
  maxStorageMb            Int
  // Cuota comercial principal: mensajes procesados por mes (in + out).
  monthlyMessageLimit     Int      @default(3000)
  // Límite técnico opcional de tokens OpenAI (protección de costos).
  monthlyTokenLimit       Int?
  allowRag                Boolean  @default(false)
  allowAudioTranscription Boolean  @default(false)
  priceMonthly            Decimal  @db.Decimal(10, 2)
  currency                String   @default("DOP")
  // Datos comerciales visibles en las cards de planes
  setupFee                Decimal? @db.Decimal(10, 2)
  setupFeeLabel           String?
  estimatedMessagesMin    Int?
  featuresJson            Json?
  isPopular               Boolean  @default(false)
  sortOrder               Int      @default(0)
  isActive                Boolean  @default(true)
  lemonSqueezyVariantId   String?
  lemonSqueezyProductId   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelRequestedAt  DateTime?
  cancelledAt        DateTime?
  // ── Venta manual / plan personalizado (SUPER_ADMIN) ──
  billingMode   BillingMode   @default(MANUAL)
  paymentStatus PaymentStatus @default(NOT_REQUIRED)
  // Nombre comercial visible cuando el plan es negociado ("Plan personalizado")
  customPlanName    String?
  customMonthlyPrice Decimal? @db.Decimal(10, 2)
  customSetupFee     Decimal? @db.Decimal(10, 2)
  nextBillingDate    DateTime?
  // Overrides por tenant (negociados); null usa el valor del plan
  customMonthlyMessageLimit Int?
  customMonthlyTokenLimit   Int?
  customMaxUsers            Int?
  customMaxAgents           Int?
  customMaxWhatsappNumbers  Int?
  // Minutos de llamadas IA negociados (Enterprise); null usa usuarios × cuota
  customVoiceMinutesLimit   Int?
  // Identificadores de LemonSqueezy (se llenan vía webhook; nunca datos de tarjeta)
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?   @unique
  lemonSqueezyOrderId        String?
  lemonSqueezyVariantId      String?
  lemonSqueezyProductId      String?
  renewsAt                   DateTime?
  endsAt                     DateTime?
  // Último webhook de billing procesado para esta suscripción (auditoría admin)
  lastWebhookAt              DateTime?
  // Último evento crudo relevante (event_name, test_mode, status LS...)
  metadataJson               Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan                  @relation(fields: [planId], references: [id])
  cancellationRequests CancellationRequest[]

  @@index([planId])
}

model CancellationRequest {
  id                String             @id @default(cuid())
  tenantId          String
  subscriptionId    String
  requestedByUserId String
  reason            String
  status            CancellationStatus @default(PENDING)
  adminNotes        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  requestedBy  User         @relation(fields: [requestedByUserId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

model Agent {
  id                    String      @id @default(cuid())
  tenantId              String
  name                  String
  description           String?
  type                  AgentType   @default(SALES)
  status                AgentStatus @default(ACTIVE)
  systemPrompt          String?
  tone                  String?
  department            String?
  whatsappPhoneNumberId String?
  whatsappDisplayPhone  String?
  openAiModel           String      @default("gpt-4.1-mini")
  allowAudioMessages    Boolean     @default(false)
  allowHumanHandoff     Boolean     @default(true)
  // Puede contestar llamadas IA (solo efectivo con entitlement de voz del tenant)
  allowVoiceCalls       Boolean     @default(false)
  // Agente de ElevenLabs Conversational AI vinculado (mapea el webhook post-call)
  elevenLabsAgentId     String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  quotes        Quote[]
  usageMetrics  UsageMetric[]
  appointments  Appointment[]
  callLogs      CallLog[]

  @@index([tenantId])
  @@index([whatsappPhoneNumberId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  phone     String
  email     String?
  // Notas internas del equipo sobre el contacto (no visibles para el cliente)
  notes     String?
  lastActivityAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  quotes        Quote[]

  @@unique([tenantId, phone])
  @@index([phone])
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String
  agentId            String?
  customerId         String
  whatsappPhone      String?
  customerName       String?
  // Canal de origen: default WHATSAPP preserva todo lo existente
  channel            ConversationChannel @default(WHATSAPP)
  status             ConversationStatus @default(BOT_ACTIVE)
  assignedToUserId   String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  currentQuoteId     String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent      Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?          @relation("AssignedConversations", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  quotes       Quote[]
  handoffs     HumanHandoff[]
  appointments Appointment[]
  labels       ConversationLabelAssignment[]
  callLogs     CallLog[]

  @@index([tenantId])
  @@index([customerId])
  @@index([agentId])
  @@index([status])
  @@index([whatsappPhone])
  @@index([lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  senderType        SenderType
  messageType       MessageType      @default(TEXT)
  textContent       String?
  mediaUrl          String?
  transcriptionText String?
  whatsappMessageId String?
  metadata          Json?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([whatsappMessageId])
  @@index([createdAt])
}

model Quote {
  id             String      @id @default(cuid())
  tenantId       String
  conversationId String?
  customerId     String
  agentId        String?
  quoteNumber    String
  status         QuoteStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  taxRate        Decimal     @default(0.18) @db.Decimal(5, 4)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  currency       String      @default("DOP")
  pdfUrl         String?
  validUntil     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lines        QuoteLine[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([conversationId])
  @@index([agentId])
  @@index([createdAt])
}

model QuoteLine {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  sku         String?
  name        String
  // Texto libre legado; la referencia estructurada es categoryId/categoryRef.
  category    String?
  categoryId  String?
  itemType    CatalogItemType @default(PRODUCT)
  brand       String?
  description String?
  unit        String   @default("unidad")
  price       Decimal  @db.Decimal(12, 2)
  // ITBIS aplicado al ítem (0.18 = 18%). taxable=false para exentos.
  taxRate          Decimal @default(0.18) @db.Decimal(5, 4)
  priceIncludesTax Boolean @default(false)
  // Cantidad disponible; null para servicios (no manejan stock).
  stock       Int?     @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryRef  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases      ProductAlias[]
  lines        QuoteLine[]
  appointments Appointment[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([name])
  @@index([category])
  @@index([categoryId])
  @@index([brand])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductAlias {
  id        String    @id @default(cuid())
  productId String
  alias     String
  aliasType AliasType
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@unique([productId, alias])
}

model Appointment {
  id             String  @id @default(cuid())
  tenantId       String
  agentId        String?
  conversationId String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  requestedAt    DateTime @default(now())
  scheduledAt    DateTime
  serviceOrProduct String
  catalogItemId  String?
  notes          String?
  source             AppointmentSource       @default(MANUAL)
  status             AppointmentStatus       @default(PENDING)
  confirmationStatus AppointmentConfirmation @default(UNCONFIRMED)
  priority           AppointmentPriority     @default(NORMAL)
  // Override por cita: { hoursBefore, enabled }; null usa la config del tenant.
  reminderConfig Json?
  lastReminderAt DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  rescheduledAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  catalogItem  Product?      @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([scheduledAt])
  @@index([status])
  @@index([customerPhone])
  @@index([conversationId])
}

// Etiquetas de conversación (a nivel conversación y no contacto: el mismo
// cliente puede tener una conversación de "Cotización" y otra de "Soporte").
model ConversationLabel {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String   @default("slate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ConversationLabelAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ConversationLabelAssignment {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        ConversationLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
}

model HumanHandoff {
  id             String        @id @default(cuid())
  tenantId       String
  conversationId String
  reason         String
  status         HandoffStatus @default(OPEN)
  assignedTo     String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([status])
}

model AgentLog {
  id             String   @id @default(cuid())
  tenantId       String?
  agentId        String?
  conversationId String?
  input          String
  output         Json?
  intent         String?
  confidence     Decimal? @db.Decimal(5, 4)
  requiresHuman  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([conversationId])
  @@index([intent])
}

model KnowledgeDocument {
  id               String         @id @default(cuid())
  tenantId         String
  uploadedByUserId String?
  title            String
  fileName         String
  fileType         String
  fileUrl          String
  status           DocumentStatus @default(UPLOADED)
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  tenantId   String
  documentId String
  content    String
  metadata   Json?
  createdAt  DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
}

model Integration {
  id              String            @id @default(cuid())
  tenantId        String
  type            IntegrationType
  name            String
  status          IntegrationStatus @default(ACTIVE)
  encryptedConfig Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
}

// Conexión de WhatsApp Business Cloud API POR TENANT (cada cliente usa su
// propia app/token de Meta; el token global del .env queda solo como fallback
// de demo controlado). Separado del modelo Integration genérico porque el
// webhook necesita lookup único e indexado por phoneNumberId y campos
// consultables (verifyToken, estado de validación) que un JSON cifrado no da.
model WhatsAppIntegration {
  id       String                    @id @default(cuid())
  tenantId String
  provider WhatsAppProvider          @default(META_CLOUD)
  // Default MANUAL_CLOUD_API: las integraciones existentes se crearon así.
  mode     WhatsAppConnectionMode    @default(MANUAL_CLOUD_API)
  status   WhatsAppIntegrationStatus @default(DRAFT)

  businessName String?
  // DEPRECADO: nombre histórico del WABA ID. Se sigue escribiendo en sincronía
  // con `wabaId` para no romper la config manual ya guardada; leer `wabaId`.
  businessAccountId String?
  // WABA ID (WhatsApp Business Account) — lo devuelve Embedded Signup.
  wabaId String?
  // Meta Business ID (la empresa dueña de la WABA). Distinto del WABA ID;
  // lo devuelve Embedded Signup y lo piden los BSP.
  businessId String?
  // Nullable desde el modo guiado: una solicitud de conexión asistida existe
  // ANTES de que haya número. Sigue siendo único global (Postgres permite
  // múltiples NULL), así que el lookup del webhook no cambia.
  phoneNumberId      String? @unique // el mismo ID que se asigna a Agent.whatsappPhoneNumberId
  displayPhoneNumber String?
  graphApiVersion    String  @default("v20.0")

  // Verify token propio del tenant para el GET de verificación del webhook.
  // Se genera automáticamente; el webhook acepta este O el global (compat).
  verifyToken String @unique

  // Access token de Meta cifrado con AES-256-GCM (lib/crypto.ts encryptJson).
  // NUNCA se devuelve al frontend; solo se expone tokenLastFour.
  accessTokenEncrypted String?
  tokenLastFour        String?
  tokenExpiresAt       DateTime?

  webhookUrl          String?
  webhookVerifiedAt   DateTime?
  lastValidationAt    DateTime?
  lastValidationError String?

  // ── Embedded Signup (flujo oficial de Meta) ──
  // El `code` de Meta NO se persiste: vive 30 segundos y es una credencial de
  // un solo uso; se intercambia en el acto y se descarta.
  embeddedSignupCompletedAt DateTime?
  // Cuándo se suscribió la app a los webhooks de la WABA del cliente
  webhookSubscribedAt DateTime?
  // Último resultado del health check (para el panel admin sin re-consultar Meta)
  lastHealthStatus String?

  // ── Preparación del número (wizard "Preparar número") ──
  // Campos consultables (no JSON) porque el panel admin filtra y ordena por
  // ellos: "qué clientes necesitan número nuevo", "cuáles esperan revisión".
  numberReadiness WhatsAppNumberReadiness @default(UNKNOWN)
  readinessStage  WhatsAppReadinessStage?
  // Opción que eligió el cliente en el wizard (PERSONAL, BUSINESS_APP, ...)
  declaredNumberType String?
  // Número que el cliente DICE querer usar. Solo lo ve el equipo; al ticket
  // de soporte va enmascarado.
  declaredPhoneNumber String?
  // Proveedor/BSP donde está hoy el número, si aplica (texto libre)
  currentProvider String?
  // Recomendación que el sistema le dio (para que soporte vea lo mismo que él)
  readinessRecommendation String?
  // Comentarios del cliente en el wizard
  readinessNotes     String?
  readinessUpdatedAt DateTime?

  // ── Conexión asistida por el equipo Sendwary (modo EASY_ONBOARDING) ──
  // Campos consultables (no JSON) porque el panel admin filtra y ordena por
  // ellos: "quién pidió ayuda y desde cuándo".
  assistedSetupRequestedAt     DateTime?
  assistedSetupRequestedByUserId String?
  assistedSetupStartedAt       DateTime?
  // Notas internas del equipo Sendwary (el tenant NUNCA las ve)
  adminNotes String?

  // ── Modo demo (número de Sendwary, solo pruebas) ──
  demoMessagesUsed Int @default(0)

  // Datos libres del proveedor/onboarding (respuesta de Embedded Signup,
  // checklist de requisitos, IDs del BSP). Nunca contiene tokens.
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([mode])
  @@index([assistedSetupRequestedAt])
  @@index([numberReadiness])
  @@index([readinessStage])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  tenantId     String?
  key          String
  scope        String
  requestHash  String?
  responseBody Json?
  statusCode   Int?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, scope])
  @@index([tenantId])
  @@index([expiresAt])
}

// Contador mensual de minutos de llamadas IA (espejo de UsageCounter para voz).
// includedMinutes/extraMinutes NO se persisten: se calculan al leer contra el
// límite vigente (que puede cambiar a mitad de mes).
model VoiceUsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  usedSeconds Int      @default(0)
  callCount   Int      @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId])
}

// Registro individual de cada llamada IA (idempotencia por elevenLabsCallId).
model CallLog {
  id                       String  @id @default(cuid())
  tenantId                 String
  agentId                  String?
  userId                   String?
  conversationId           String?
  elevenLabsConversationId String?
  elevenLabsCallId         String? @unique
  direction                CallDirection @default(INBOUND)
  status                   CallStatus    @default(STARTED)
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  durationSeconds  Int       @default(0)
  estimatedCostUsd Decimal   @default(0) @db.Decimal(10, 4)
  customerPhone    String?
  summary          String?
  transcript       String?
  metadata         Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, startedAt])
  @@index([agentId])
}

// Contador agregado de consumo por tenant y periodo (mes calendario).
// A diferencia de UsageMetric (eventos individuales para dashboard), este es
// el registro que el enforcement de planes lee en caliente: una sola fila.
model UsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  inboundMessages  Int @default(0)
  outboundMessages Int @default(0)
  totalMessages    Int @default(0)
  aiInputTokens    Int @default(0)
  aiOutputTokens   Int @default(0)
  aiTotalTokens    Int @default(0)
  audioTranscriptionSeconds Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId])
}

model UsageMetric {
  id         String     @id @default(cuid())
  tenantId   String
  agentId    String?
  metricType MetricType
  quantity   Int        @default(1)
  metadata   Json?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([agentId])
  @@index([metricType])
  @@index([createdAt])
}

// ─── Soporte (asistente IA de soporte + tickets) ─────────────────────────────
// Los playbooks viven en markdown (docs/support-playbooks/); la BD solo
// persiste tickets y su auditoría. Sin relaciones duras a Tenant/User para
// poder registrar tickets de sistema (tenantId null) sin tocar esos modelos.

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  ESCALATED
  CLOSED
}

enum SupportTier {
  TIER_1
  TIER_2
  TIER_3
}

enum SupportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportSource {
  USER
  SYSTEM
  AI
  ADMIN
}

enum SupportActorType {
  AI
  USER
  ADMIN
  SYSTEM
}

model SupportTicket {
  id                String              @id @default(cuid())
  tenantId          String?
  userId            String?
  createdByUserId   String?
  assignedToAdminId String?
  title             String
  description       String
  status            SupportTicketStatus @default(OPEN)
  tier              SupportTier         @default(TIER_2)
  severity          SupportSeverity     @default(MEDIUM)
  category          String?
  source            SupportSource       @default(USER)
  aiSummary         String?
  detectedIssue     String?
  recommendedAction String?
  resolution        String?
  metadataJson      Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  resolvedAt        DateTime?

  auditLogs SupportAuditLog[]

  @@index([tenantId])
  @@index([status])
  @@index([tier])
  @@index([severity])
  @@index([createdAt])
}

model SupportAuditLog {
  id              String           @id @default(cuid())
  supportTicketId String?
  actorType      SupportActorType
  // id del usuario/admin o etiqueta del agente IA ("support-agent")
  actorId        String?
  action         String
  detailsJson    Json?
  createdAt      DateTime         @default(now())

  ticket SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  @@index([supportTicketId])
  @@index([createdAt])
}
