generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
}

enum AliasType {
  SYNONYM
  TECHNICAL_NAME
  COMMON_MISTAKE
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  WAITING_HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SenderType {
  CUSTOMER
  AGENT
  HUMAN
  SYSTEM
}

enum QuoteStatus {
  DRAFT
  SENT
  NEEDS_CONFIRMATION
  CANCELLED
}

enum HandoffStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CANCELLED
}

model Business {
  id        String   @id @default(cuid())
  name      String
  rnc       String?
  phone     String?
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  customers     Customer[]
  conversations Conversation[]
  quotes        Quote[]
  handoffs      HumanHandoff[]
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  sku         String
  name        String
  category    String?
  brand       String?
  description String?
  unit        String
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aliases  ProductAlias[]
  lines    QuoteLine[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([name])
  @@index([category])
  @@index([brand])
}

model ProductAlias {
  id        String    @id @default(cuid())
  productId String
  alias     String
  aliasType AliasType
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@unique([productId, alias])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String?
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  quotes        Quote[]

  @@unique([businessId, phone])
  @@index([phone])
}

model Conversation {
  id             String             @id @default(cuid())
  businessId     String
  customerId     String
  status         ConversationStatus @default(ACTIVE)
  lastMessageAt  DateTime?
  metadata       Json?
  currentQuoteId String?
  requiresHuman  Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  messages Message[]
  quotes   Quote[]
  handoffs HumanHandoff[]

  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  senderType     SenderType
  content        String
  messageId      String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
}

model Quote {
  id             String      @id @default(cuid())
  businessId     String
  customerId     String
  conversationId String?
  quoteNumber    String
  status         QuoteStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  taxRate        Decimal     @default(0.18) @db.Decimal(5, 4)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  pdfUrl         String?
  validUntil     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  lines QuoteLine[]

  @@unique([businessId, quoteNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([conversationId])
}

model QuoteLine {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}

model HumanHandoff {
  id             String        @id @default(cuid())
  businessId     String
  conversationId String
  reason         String
  status         HandoffStatus @default(OPEN)
  assignedTo     String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([conversationId])
  @@index([status])
}

model AgentLog {
  id             String   @id @default(cuid())
  conversationId String?
  input          String
  output         Json?
  intent         String?
  confidence     Decimal? @db.Decimal(5, 4)
  requiresHuman  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([intent])
}