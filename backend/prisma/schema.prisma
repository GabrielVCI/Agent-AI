// Webhook de billing que NO se pudo asociar a ningún tenant (sin custom_data
// y sin match por email de owner). Queda para revisión manual del SUPER_ADMIN:
// NUNCA se activa un tenant "adivinando".
model UnmatchedBillingWebhook {
  id                         String    @id @default(cuid())
  provider                   String    @default("LEMONSQUEEZY")
  eventName                  String
  lemonSqueezySubscriptionId String?
  customerEmail              String?
  payloadJson                Json
  createdAt                  DateTime  @default(now())
  resolvedAt                 DateTime?

  @@index([createdAt])
}

/// Estado TÉCNICO de una correlación de LemonSqueezy. NO es SubscriptionStatus:
/// describe en qué punto está el emparejamiento "suscripción de LS ↔ tenant",
/// no si el cliente tiene acceso (eso lo dice Subscription.status).
enum LemonSqueezyCorrelationStatus {
  /// subscription_created correlacionado; falta que LS confirme el primer pago.
  PENDING_PAYMENT
  /// El pago llegó ANTES que subscription_created (o sin custom_data): la
  /// factura queda guardada esperando saber de qué tenant es.
  PENDING_CORRELATION
  /// Primer pago confirmado; la Subscription local aún no pudo escribirse
  /// (p. ej. la API de LS no respondió). Reprocesable.
  PAID
  /// Subscription local creada/activada a partir de este primer pago.
  PROCESSED
  /// Inconsistencia detectada (variante que no corresponde al plan, tenant o
  /// plan inexistente, test_mode incoherente). NUNCA activa nada.
  INVALID
}

/// Correlación persistente entre una suscripción de LemonSqueezy y el
/// tenant/plan de Sendwary que la originó.
///
/// Existe porque los dos eventos del alta traen datos distintos:
///   · `subscription_created` trae `meta.custom_data` (tenant_id, plan_id) pero
///     NO confirma el cobro.
///   · `subscription_payment_success` trae la FACTURA (billing_reason, status)
///     y puede no traer custom_data.
/// Guardar aquí el vínculo es lo que permite que el pago —única autoridad para
/// activar— sepa a quién activar, y que ambos eventos lleguen en cualquier orden.
///
/// Esta fila NO concede acceso por sí misma: el entitlement vive en
/// Subscription. Aquí solo hay estado técnico de emparejamiento.
model LemonSqueezySubscriptionCorrelation {
  id String @id @default(cuid())

  /// Id de la suscripción en LemonSqueezy. UNIQUE: es la clave de correlación
  /// y la barrera contra filas duplicadas bajo concurrencia.
  // Nombre del índice acortado a mano: el que Prisma derivaría supera los 63
  // caracteres que PostgreSQL admite en un identificador y quedaría truncado.
  lemonSqueezySubscriptionId String @unique(map: "LemonSqueezySubCorrelation_subscriptionId_key")

  /// Nulos solo mientras el pago haya llegado antes que `subscription_created`.
  /// Sin relación declarada a propósito: es una tabla técnica de billing que
  /// debe sobrevivir para soporte aunque el tenant desaparezca; tenant y plan
  /// se RE-VALIDAN contra la BD antes de activar nada.
  tenantId String?
  planId   String?

  /// Variante que el plan declaraba al crear el checkout. El primer pago debe
  /// cobrar exactamente esta variante (validación cruzada en el handler).
  expectedVariantId String?

  lemonSqueezyCustomerId String?
  lemonSqueezyOrderId    String?
  lemonSqueezyProductId  String?
  lemonSqueezyVariantId  String?

  status LemonSqueezyCorrelationStatus @default(PENDING_PAYMENT)

  /// Factura del PRIMER cobro (billing_reason=initial) que activó —o activará—
  /// la suscripción. Idempotencia: la misma factura no se aplica dos veces.
  paidInvoiceId String?
  paidAt        DateTime?

  /// true = suscripción de TEST MODE de LemonSqueezy.
  testMode Boolean?

  /// Suscripción local resultante, cuando ya se creó.
  subscriptionId String?

  processedAt DateTime?
  /// Motivo técnico corto del último rechazo (sin secretos ni payload).
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([lemonSqueezyCustomerId])
}

/// Estado de procesamiento de un webhook de LemonSqueezy.
enum LemonSqueezyWebhookStatus {
  RECEIVED
  PROCESSED
  /// Recibido y descartado a propósito (evento que no nos interesa, o sin
  /// tenant mapeable). No es un fallo: no debe reintentarse.
  IGNORED
  FAILED
}

/// Registro de idempotencia de los webhooks de LemonSqueezy.
///
/// LS reintenta los eventos; sin esto un `subscription_created` repetido
/// volvería a ejecutar efectos. `dedupeKey` es la identidad estable del
/// evento (eventName + tipo + id de recurso + hash del cuerpo crudo): un
/// reintento idéntico choca contra el UNIQUE y se responde 200 sin reprocesar.
///
/// NO se guarda el body crudo (puede traer PII y datos de pago): solo su
/// hash SHA-256 y los identificadores necesarios para soporte.
model LemonSqueezyWebhookEvent {
  id String @id @default(cuid())

  eventName    String
  /// "subscriptions", "subscription-invoices", "orders"...
  resourceType String
  /// Id del recurso en LemonSqueezy (data.id).
  resourceId   String?

  /// Identidad estable del evento. UNIQUE: es la barrera de idempotencia.
  dedupeKey   String @unique
  /// SHA-256 hex del cuerpo crudo recibido (auditoría, nunca el cuerpo).
  payloadHash String

  status LemonSqueezyWebhookStatus @default(RECEIVED)

  /// Se llenan cuando el evento pudo correlacionarse.
  tenantId       String?
  subscriptionId String?

  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  attemptCount Int       @default(1)
  /// Mensaje técnico corto del último fallo (sin secretos ni payload).
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventName])
  @@index([status])
  @@index([resourceId])
  @@index([tenantId])
  @@index([receivedAt])
}

